{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "QuorumPolicy",
  "type": "object",
  "required": ["policyId", "version", "minBuilders", "requiredAgreement", "requiredIndependentGroups", "requireSourceMatch", "requireAllSignaturesValid", "conflictTolerance", "allowedVerificationSources"],
  "properties": {
    "policyId": { "type": "string" },
    "version": { "type": "string" },
    "minBuilders": { "type": "integer", "minimum": 1 },
    "requiredAgreement": { "type": "integer", "minimum": 1 },
    "requiredIndependentGroups": { "type": "integer", "minimum": 1 },
    "requireSourceMatch": { "type": "boolean" },
    "requireAllSignaturesValid": { "type": "boolean" },
    "conflictTolerance": { "type": "integer", "minimum": 0 },
    "allowedVerificationSources": { "type": "array", "items": { "type": "string" } },
    "policyHash": { "type": "string" }
  }
}
