{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BuilderEvidence",
  "type": "object",
  "required": ["builderId", "independenceGroup", "sourceCommit", "artifactDigest", "signatureValid", "verificationSource"],
  "properties": {
    "builderId": { "type": "string" },
    "independenceGroup": { "type": "string" },
    "sourceCommit": { "type": "string" },
    "artifactDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "signatureValid": { "type": "boolean" },
    "verificationSource": { "type": "string" }
  }
}
