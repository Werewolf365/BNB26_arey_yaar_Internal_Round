{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "InTotoStatementRef",
  "description": "Reference to the standard in-toto Statement v1 + SLSA provenance v1 (SLSA v1.2 current). Quorum never invents its own attestation envelope: envelope=DSSE, statement=in-toto, predicate=https://slsa.dev/provenance/v1. See docs/attestations.md.",
  "type": "object",
  "required": ["_type", "subject", "predicateType", "predicate"],
  "properties": {
    "_type": { "const": "https://in-toto.io/Statement/v1" },
    "subject": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "digest"],
        "properties": {
          "name": { "type": "string" },
          "digest": { "type": "object", "required": ["sha256"], "properties": { "sha256": { "type": "string" } } }
        }
      }
    },
    "predicateType": { "const": "https://slsa.dev/provenance/v1" },
    "predicate": { "type": "object" }
  }
}
